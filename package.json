{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:placeholder": "vitest run tests/placeholder-name.test.ts",
    "dev:core": "pnpm --filter @app/core dev",
    "dev:shell": "pnpm --filter @app/shell dev"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  }
}
