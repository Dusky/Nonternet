# Production front door (docs/01, docs/15). Not used by the local compose stack, and not yet run
# against a real domain: treat it as the reviewed starting point, not a tested deployment.
#
# Two kinds of name:
#   1. The site itself ({$SITE_DOMAIN}): shell, API, widgets and ring links.
#   2. Everything else on a normal HTTPS port: homepage names ({handle}.{homes_domain}) and
#      verified custom domains. These go to the homes server, and Caddy gets a certificate for a
#      name the first time it is asked for it, after core says the name is real (`ask`).
{
	on_demand_tls {
		# Core answers 200 for a real person's homepage name or a verified custom domain, 404 for
		# anything else. It is on the private network only; set TLS_ASK_SECRET on core to match.
		ask http://core:3000/internal/tls-ask?secret={$TLS_ASK_SECRET}
	}
}

# Security headers for the site itself (docs/15). The shell's policy: only our own scripts; styles may be inline
# (the editor and terminal inject them); the studio previews homepages from the homes domain in a frame, and
# apps people add run in a sandboxed frame from the bare homes domain (docs/10, docs/15);
# nothing may frame the site. Keep the policy in step with apps/shell/vite.config.ts (a test compares them).
(site_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; frame-src 'self' https://{$HOMES_DOMAIN} https://*.{$HOMES_DOMAIN}"
		-Server
	}
}

{$SITE_DOMAIN} {
	import site_headers
	encode gzip
	# Health and readiness come from core itself, so `sitectl doctor` and `upgrade` test the real thing, not the shell's fallback page.
	handle /healthz {
		reverse_proxy core:3000
	}
	handle /readyz {
		reverse_proxy core:3000
	}
	handle /api/* {
		reverse_proxy core:3000
	}
	handle /oidc/* {
		reverse_proxy core:3000
	}
	handle /widgets/* {
		reverse_proxy core:3000
	}
	handle /ring/* {
		reverse_proxy core:3000
	}
	# Atom feeds of public boards (docs/05).
	handle /feeds/* {
		reverse_proxy core:3000
	}
	# The Chat app's IRC connection (docs/08).
	handle /ws/irc {
		reverse_proxy ergo:8097
	}
	# The MUD window's connection (docs/09). Only the WebSocket; the MUD's web server stays private.
	handle /ws/mud {
		reverse_proxy mud:4002
	}
	# The Terminal window's connection to the BBS (docs/04).
	handle /ws/bbs {
		reverse_proxy bbs:2380
	}
	# Never reachable from outside: only Caddy's own `ask` uses it.
	respond /internal/* 404
	handle {
		reverse_proxy shell:80
	}
}

# irc.<domain>: named here so Caddy gets and renews a certificate for it, which Ergo uses for native clients on
# 6697 (compose.prod.yaml mounts Caddy's data into Ergo). `sitectl irc-reload` (weekly, from cron) makes Ergo
# pick up a renewed certificate; Ergo reloads certificates when it rehashes on SIGHUP.
irc.{$SITE_DOMAIN} {
	import site_headers
	respond "Chat is on port 6697 (TLS), or in the web app." 200
}

https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy homes:3100
}
