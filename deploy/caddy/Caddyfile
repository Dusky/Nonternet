# Front door. For local development this listens on plain HTTP; production sets
# CADDY_ADDRESS to the site domain so Caddy manages TLS (docs/01, docs/15).
{$CADDY_ADDRESS::80} {
	handle /api/* {
		reverse_proxy core:3000
	}
	handle /oidc/* {
		reverse_proxy core:3000
	}
	handle {
		reverse_proxy shell:80
	}
}
