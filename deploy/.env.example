# Copy to deploy/.env. Real secrets never go in git.
# Database passwords go into connection URLs, so use hex: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# 32 random bytes, base64: openssl rand -base64 32. Encrypts TOTP secrets and keys IP hashes.
# Losing it locks admins out of two-factor auth, so back it up with the database.
APP_SECRET_KEY=
# Shared secrets for IRC, the MUD and the BBS (32+ characters each: openssl rand -base64 32).
IRC_SECRET=
MUD_SECRET=
BBS_SECRET=
# Which site config core reads (path relative to deploy/).
SITE_CONFIG_FILE=./site.example.yaml
# Local port for the front door, and the URL emailed links point at (must match).
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
# Optional outgoing mail. Without it, verification links are printed in core's log.
# SMTP_URL=smtp://user:pass@mail.example.net:587
# MAIL_FROM=no-reply@example.net
# Production: set to the site domain so Caddy issues TLS. Leave unset locally.
# CADDY_ADDRESS=example.net

# ---- Production only (compose.prod.yaml; ./sitectl doctor checks these) ----
# SITE_DOMAIN=example.net
# HOMES_DOMAIN=example-homes.net          # needs a wildcard DNS record: *.example-homes.net
# DB_RUNTIME_PASSWORD=                     # openssl rand -hex 24 (core's own database role, which cannot change the audit log)
# TLS_ASK_SECRET=                          # openssl rand -hex 32 (Caddy asks core before getting a homepage certificate)
# BACKUP_KEY=                              # docker compose run --rm core node cli.cjs backup-key; keep a copy away from the server
# BBS_SSH_PUBLIC_PORT=2222                 # 22 if you move the host's own sshd
